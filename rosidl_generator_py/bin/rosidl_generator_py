#!/usr/bin/env python3

import argparse
import os
import sys

# A source build can find an older generator in an existing ROS overlay.
# Resolve the package beside this launcher first without changing sys.path.
rosidl_generator_py_root = os.path.dirname(os.path.dirname(__file__))
rosidl_generator_py_module = os.path.join(
    rosidl_generator_py_root, 'rosidl_generator_py', '__init__.py')
if os.path.isfile(rosidl_generator_py_module):
    from importlib.util import module_from_spec, spec_from_file_location

    spec = spec_from_file_location('rosidl_generator_py', rosidl_generator_py_module)
    rosidl_generator_py = module_from_spec(spec)
    sys.modules[spec.name] = rosidl_generator_py
    try:
        spec.loader.exec_module(rosidl_generator_py)
    except BaseException:
        sys.modules.pop(spec.name, None)
        raise
    generate_py = rosidl_generator_py.generate_py
else:
    from rosidl_generator_py import generate_py


def main(argv=sys.argv[1:]):
    parser = argparse.ArgumentParser(description='Generate the Python ROS interfaces.')
    parser.add_argument(
        '--generator-arguments-file',
        required=True,
        help='The location of the file containing the generator arguments')
    parser.add_argument(
        '--typesupport-impls',
        required=True,
        help='All the available typesupport implementations')
    args = parser.parse_args(argv)

    generate_py(args.generator_arguments_file, args.typesupport_impls.split(';'))
    return 0

if __name__ == '__main__':
    sys.exit(main())
